{
  "expo": {
    "name": "Yume",
    "slug": "yume",
    "platforms": [
      "android"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "yume",
    "android": {
      "package": "com.yume.app",
      "adaptiveIcon": {
        "backgroundColor": "#FEFBF1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": true,
      "versionCode": 23,
      "allowBackup": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-local-authentication",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8FCBFF"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-sharing",
      "./plugins/withAppShortcuts",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/fredoka/500Medium/Fredoka_500Medium.ttf",
            "./node_modules/@expo-google-fonts/fredoka/600SemiBold/Fredoka_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/archivo/400Regular/Archivo_400Regular.ttf",
            "./node_modules/@expo-google-fonts/archivo/600SemiBold/Archivo_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/space-mono/700Bold/SpaceMono_700Bold.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialCommunityIcons.ttf"
          ],
          "widgets": [
            {
              "name": "ThisMonth",
              "label": "This Month",
              "description": "This month's ring: what you spent, saved and have free, and where the month is heading.",
              "previewImage": "./assets/widget-preview/this-month.png",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "QuickAdd",
              "label": "Quick Add",
              "description": "Add an expense in one tap, straight into your most-used categories, or add income.",
              "previewImage": "./assets/widget-preview/quick-add.png",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "Suu",
              "label": "Suu Check-in",
              "description": "Suu's one-line nudge about this month's spending, right on your home screen.",
              "previewImage": "./assets/widget-preview/suu.png",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "NextDue",
              "label": "Next Due",
              "description": "The soonest loan EMI or recurring bill coming up.",
              "previewImage": "./assets/widget-preview/next-due.png",
              "minWidth": "250dp",
              "minHeight": "60dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Accounts",
              "label": "Accounts",
              "description": "Your accounts and their balances, right on the home screen.",
              "previewImage": "./assets/widget-preview/accounts.png",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FEFBF1"
        }
      ]
    ],
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "dark"
      },
      "eas": {
        "projectId": "1461f910-0ead-4d89-ac9a-b4446ee02635"
      }
    },
    "owner": "yume-expense-tracking"
  }
}
