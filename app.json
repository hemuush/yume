{
  "expo": {
    "name": "Yume",
    "slug": "yume",
    "platforms": [
      "android"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "yume",
    "android": {
      "package": "com.yume.app",
      "adaptiveIcon": {
        "backgroundColor": "#FEFBF1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": true,
      "versionCode": 1,
      "allowBackup": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-local-authentication",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8FCBFF"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }\n-keep class * extends androidx.work.ListenableWorker { <init>(android.content.Context, androidx.work.WorkerParameters); }"
          }
        }
      ],
      "expo-sharing",
      "./plugins/withAppShortcuts",
      [
        "./plugins/withThemeAppIcons",
        {
          "defaultId": "yume",
          "icons": [
            {
              "id": "yume"
            },
            {
              "id": "corpsGreen",
              "background": "#FEFBF1",
              "icon": "./assets/theme-icons/corpsGreen.png",
              "foreground": "./assets/theme-icons/corpsGreen-foreground.png"
            },
            {
              "id": "hollowViolet",
              "background": "#FEFBF1",
              "icon": "./assets/theme-icons/hollowViolet.png",
              "foreground": "./assets/theme-icons/hollowViolet-foreground.png"
            },
            {
              "id": "winterEmber",
              "background": "#FEFBF1",
              "icon": "./assets/theme-icons/winterEmber.png",
              "foreground": "./assets/theme-icons/winterEmber-foreground.png"
            },
            {
              "id": "katawareDusk",
              "background": "#FEFBF1",
              "icon": "./assets/theme-icons/katawareDusk.png",
              "foreground": "./assets/theme-icons/katawareDusk-foreground.png"
            },
            {
              "id": "crimsonNight",
              "background": "#FEFBF1",
              "icon": "./assets/theme-icons/crimsonNight.png",
              "foreground": "./assets/theme-icons/crimsonNight-foreground.png"
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/fredoka/600SemiBold/Fredoka_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/archivo/400Regular/Archivo_400Regular.ttf",
            "./node_modules/@expo-google-fonts/archivo/600SemiBold/Archivo_600SemiBold.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialCommunityIcons.ttf"
          ],
          "widgets": [
            {
              "name": "ThisMonth",
              "label": "This Month",
              "description": "Your free balance after bills, the month line, spending and savings at a glance.",
              "previewImage": "./assets/widget-preview/this-month.png",
              "minWidth": "250dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "QuickAdd",
              "label": "Quick Add",
              "description": "Add an expense in one tap, straight into your most-used categories, or add income.",
              "previewImage": "./assets/widget-preview/quick-add.png",
              "minWidth": "208dp",
              "minHeight": "184dp",
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "Suu",
              "label": "Suu Check-in",
              "description": "Suu's one-line nudge about this month's spending, right on your home screen.",
              "previewImage": "./assets/widget-preview/suu.png",
              "minWidth": "140dp",
              "minHeight": "140dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "NextDue",
              "label": "Next Due",
              "description": "The soonest loan EMI or recurring bill coming up.",
              "previewImage": "./assets/widget-preview/next-due.png",
              "minWidth": "250dp",
              "minHeight": "70dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Accounts",
              "label": "Accounts",
              "description": "Your accounts and their balances, right on the home screen.",
              "previewImage": "./assets/widget-preview/accounts.png",
              "minWidth": "250dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withWidgetPrivacy",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FEFBF1"
        }
      ]
    ],
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "dark"
      },
      "eas": {
        "projectId": "f12d79ce-5d59-449a-9d84-020a9abc95e4"
      }
    },
    "owner": "hemant.shrma.3004"
  }
}
