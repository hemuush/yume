{
  "expo": {
    "name": "Yume",
    "slug": "yume",
    "platforms": [
      "android"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "yume",
    "android": {
      "package": "com.yume.app",
      "adaptiveIcon": {
        "backgroundColor": "#FEFBF1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": true,
      "versionCode": 1,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-local-authentication",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8FCBFF"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-sharing",
      "./plugins/withAppShortcuts",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/DotGothic16.ttf"
          ],
          "widgets": [
            {
              "name": "ThisMonth",
              "label": "This Month",
              "description": "This month's spend, the change vs last month, and the spend/kept bar.",
              "previewImage": "./assets/widget-preview/this-month.png",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "QuickAdd",
              "label": "Quick Add",
              "description": "One tap into Add Transaction, pre-set to Expense or Income.",
              "previewImage": "./assets/widget-preview/quick-add.png",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "Suu",
              "label": "Suu Check-in",
              "description": "Suu's one-line nudge about this month's spending, right on your home screen.",
              "previewImage": "./assets/widget-preview/suu.png",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "NextDue",
              "label": "Next Due",
              "description": "The soonest loan EMI or recurring bill coming up.",
              "previewImage": "./assets/widget-preview/next-due.png",
              "minWidth": "250dp",
              "minHeight": "60dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Accounts",
              "label": "Accounts",
              "description": "Live balances for your accounts, right on the home screen.",
              "previewImage": "./assets/widget-preview/accounts.png",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FEFBF1"
        }
      ]
    ],
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "dark"
      },
      "eas": {
        "projectId": "1461f910-0ead-4d89-ac9a-b4446ee02635"
      }
    },
    "owner": "yume-expense-tracking"
  }
}
